From 8b15547cc56b6d648155009e93cf1cfec2766086 Mon Sep 17 00:00:00 2001
From: Lianzhong You <youyve@foxmail.com>
Date: Wed, 16 Sep 2026 16:59:11 +0800
Subject: [PATCH 2/2] fix(ascend): release owned CANN events on destruction

Extract the event lifetime fix from Kistich ascend-flagcx-adapt. Initialize the handle and prohibit copying to avoid duplicate ownership. Add host-only mocked ACL lifecycle regression; hardware teardown still requires validation.

Co-authored-by: Kistich <kistich@users.noreply.github.com>
---
 plugin/torch/flagcx/include/event_flagcx.hpp | 10 +++++++++-
 test/host_stubs/acl/acl_rt.h                 | 20 ++++++++++++++++++++
 test/host_stubs/flagcx.h                     |  2 ++
 test/host_stubs/test_cann_event.cpp          | 18 ++++++++++++++++++
 4 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 test/host_stubs/acl/acl_rt.h
 create mode 100644 test/host_stubs/flagcx.h
 create mode 100644 test/host_stubs/test_cann_event.cpp

diff --git a/plugin/torch/flagcx/include/event_flagcx.hpp b/plugin/torch/flagcx/include/event_flagcx.hpp
index 0de6dd3..da43905 100644
--- a/plugin/torch/flagcx/include/event_flagcx.hpp
+++ b/plugin/torch/flagcx/include/event_flagcx.hpp
@@ -142,6 +142,14 @@ inline aclrtStream GetFlagcxCurrentAclStream(int device_id) {
 class flagcxCannEvent : public flagcxEvent {
 public:
   flagcxCannEvent() { aclrtCreateEvent(&npu_event); }
+  ~flagcxCannEvent() override {
+    if (npu_event != nullptr) {
+      aclrtDestroyEvent(npu_event);
+    }
+  }
+
+  flagcxCannEvent(const flagcxCannEvent &) = delete;
+  flagcxCannEvent &operator=(const flagcxCannEvent &) = delete;
 
   void record(const int device_id) override {
     aclrtRecordEvent(npu_event, GetFlagcxCurrentAclStream(device_id));
@@ -162,7 +170,7 @@ public:
   }
 
 private:
-  aclrtEvent npu_event;
+  aclrtEvent npu_event = nullptr;
 };
 #elif USE_CAMBRICON_ADAPTOR
 class flagcxMluEvent : public flagcxEvent {
diff --git a/test/host_stubs/acl/acl_rt.h b/test/host_stubs/acl/acl_rt.h
new file mode 100644
index 0000000..af6dd50
--- /dev/null
+++ b/test/host_stubs/acl/acl_rt.h
@@ -0,0 +1,20 @@
+#pragma once
+// Host-only ownership test doubles; no device semantics are simulated.
+using aclrtEvent = void *;
+using aclrtStream = void *;
+inline int creates = 0, destroys = 0;
+inline bool fail_create = false;
+inline int aclrtCreateEvent(aclrtEvent *event) {
+  if (fail_create) return 1;
+  ++creates;
+  *event = new int(1);
+  return 0;
+}
+inline int aclrtDestroyEvent(aclrtEvent event) {
+  ++destroys;
+  delete static_cast<int *>(event);
+  return 0;
+}
+inline int aclrtCreateStream(aclrtStream *stream) { *stream = nullptr; return 0; }
+inline int aclrtRecordEvent(aclrtEvent, aclrtStream) { return 0; }
+inline int aclrtStreamWaitEvent(aclrtStream, aclrtEvent) { return 0; }
diff --git a/test/host_stubs/flagcx.h b/test/host_stubs/flagcx.h
new file mode 100644
index 0000000..b520230
--- /dev/null
+++ b/test/host_stubs/flagcx.h
@@ -0,0 +1,2 @@
+#pragma once
+using flagcxStream_t = void *;
diff --git a/test/host_stubs/test_cann_event.cpp b/test/host_stubs/test_cann_event.cpp
new file mode 100644
index 0000000..f5e4056
--- /dev/null
+++ b/test/host_stubs/test_cann_event.cpp
@@ -0,0 +1,18 @@
+// Compile with -std=c++17 -DUSE_ASCEND_ADAPTOR=1 -Itest/host_stubs
+// -Iplugin/torch/flagcx/include. Does not validate ACL/device execution.
+#include "event_flagcx.hpp"
+#include <cassert>
+#include <memory>
+#include <type_traits>
+
+int main() {
+  static_assert(!std::is_copy_constructible<c10d::flagcxCannEvent>::value);
+  static_assert(!std::is_copy_assignable<c10d::flagcxCannEvent>::value);
+  for (int i = 0; i < 1000; ++i) {
+    std::unique_ptr<c10d::flagcxEvent> event(new c10d::flagcxCannEvent);
+  }
+  assert(creates == 1000 && destroys == 1000);
+  fail_create = true;
+  { c10d::flagcxCannEvent event; }
+  assert(creates == 1000 && destroys == 1000);
+}
