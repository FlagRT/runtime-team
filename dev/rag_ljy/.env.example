# Elasticsearch + Ascend NPU RAG 环境变量（cp 成 .env 后编辑；.env 不入仓）
# 公共 NPU 配置见 dev/compose.base.yml。

# 宿主机模型目录；挂载到 NPU 开发容器的相同路径。
MODEL_DIR=/mnt/raid/jliu171/models

# Elasticsearch 开发实例。首次启动前请修改默认密码。
ELASTICSEARCH_VERSION=9.5.2
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_MEMORY_LIMIT=4g
ELASTIC_PASSWORD=change-this-development-password
