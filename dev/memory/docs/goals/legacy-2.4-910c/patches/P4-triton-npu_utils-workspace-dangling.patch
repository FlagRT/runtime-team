+// flagos 环境:真 torch_npu 的 allocate_workspace 返回持久 workspace 池内存,
+// 而 at::empty 临时对象表达式结束即析构(内存回缓存池) → 悬空指针,
+// 异步 kernel 读/写该 workspace 会触发设备端死循环(unified_attention 31812B workspace 实测卡死)。
+// 修法:static 缓存按 size 保活 tensor,launch 同步执行(rtStreamSynchronize 后才返回),
+// 同 size 复用同一块安全;跨 size 各留一块,进程内无释放(量级:每 size 一块,可接受)。
+static std::mutex g_ws_mu;
+static std::unordered_map<uint64_t, at::Tensor> g_ws_cache;
+
 extern "C" void* triton_allocate_workspace_legacy(uint64_t size)
 {
-  return const_cast<void*>(
-      at::empty(size, at::TensorOptions().device(at::kPrivateUse1).dtype(at::kByte))
-          .storage()
-          .data());
+  std::lock_guard<std::mutex> lk(g_ws_mu);
+  auto it = g_ws_cache.find(size);
+  if (it == g_ws_cache.end()) {
+    at::Tensor t = at::empty(size, at::TensorOptions().device(at::kPrivateUse1).dtype(at::kByte));
+    it = g_ws_cache.emplace(size, std::move(t)).first;
+  }
+  return const_cast<void*>(it->second.storage().data());
 }
 
