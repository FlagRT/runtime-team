# memory 子方向环境变量配置（cp 成 .env 后编辑；.env 不入仓，每人一份）
# 公共配置见 dev/compose.base.yml
#
# 当前无子方向专属 .env 变量；默认值即可直接启动容器。

# ---- P800 环境变量模板（仅作模板、不启用；实际由 docker-compose.p800.yml 注入，.env 无需重复设置）----
# 栈：厂商设备插件（昇腾 torch_npu / 昆仑芯 xpytorch）+ FlagGems + FlagCX + vllm-plugin-FL
# VLLM_PLUGINS=fl
# VLLM_FL_PLATFORM=kunlunxin
# VLLM_FL_PREFER="flagos|vendor"
# USE_FLAGGEMS=1
# GEMS_VENDOR=kunlunxin
# KLX_USE_AUTOTUNE=0
#（DO_NOT_TRACK=1 已由 compose.base.yml 注入，无需在此设置）
