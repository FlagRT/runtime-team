# memory 子方向环境变量配置（cp 成 .env 后编辑；.env 不入仓，每人一份）
# 公共配置见 dev/compose.base.yml

# ⚠️ B 线（torch_fl）开关：torch_fl CachingDeviceAllocator 显存池（910c B 线预研用，默认开启）
#    A 线不使用（昆仑芯 torch_plugin 0.1.0 无 torch_fl 显存池，该开关无意义）
FLAGOS_USE_CACHING_ALLOCATOR=true

# ---- P800 A 线环境变量模板（仅作模板、不启用；实际由 docker-compose.p800.yml 注入，.env 无需重复设置）----
# 路线说明：A 线 = 厂商设备插件（昇腾 torch_npu / 昆仑芯 xpytorch）+ FlagGems + FlagCX + vllm-plugin-FL
# VLLM_PLUGINS=fl
# VLLM_FL_PLATFORM=kunlunxin
# VLLM_FL_PREFER="flagos|vendor"
# USE_FLAGGEMS=1
# GEMS_VENDOR=kunlunxin
# KLX_USE_AUTOTUNE=0
#（DO_NOT_TRACK=1 已由 compose.base.yml 注入，无需在此设置）
