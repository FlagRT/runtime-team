# device-context 方向 · 环境变量模板（cp 成 .env 按需调整；.env 已在根 .gitignore 里，不入仓）
#
# ⚠️ 本文件是**方向级**模板，历史上配合已退役的 `dev/compose.base.yml` 使用。
#    现行机制下，每个运行环境目录各有自己的 `.env.example`（与其 docker-compose.yml 同目录）：
#      dev/device-context/910C/env/train/.env.example   # 训练腿（含 die 号，必填）
#      dev/device-context/910C/env/infer/.env.example   # 推理腿（含 die 号，必填）
#    请优先用那两个；本文件只保留跨腿通用项，避免与它们重复。
#
# 【已退役，不要再设】
#   VLLM_FL_FLAGOS_BLACKLIST=cos,sin —— 910C 推理腿改用华为昇腾官方 vllm-ascend 后，
#     该规避配置退出现行清单（见 docs/运行时基座-使用与维护指南.md §6）。
#   与之配套的 compose.base.yml 注入项（GEMS_VENDOR / TRITON_ENABLE_TASKQUEUE /
#     FLAGCX_PATH / HCCL_NPU_SOCKET_PORT_RANGE）随 compose.base.yml 一并退役，
#     现行随各镜像 demo / 运行环境目录各自的声明走。

# 容器内通用项（推理腿 demo 已设，自建环境补上）
DO_NOT_TRACK=1
