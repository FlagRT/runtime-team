--- /dev/null
+++ b/tests/unit_tests/dispatch/test_safe_cached_op.py
@@ -0,0 +1,62 @@
+"""Exercise safety through the same CachedOp entry used by vLLM layers."""
+
+import os
+
+import pytest
+
+import vllm_fl.dispatch as dispatch
+from vllm_fl.dispatch import BackendImplKind as Kind, OpImpl, SelectionPolicy
+
+
+@pytest.fixture
+def manager(monkeypatch):
+    dispatch.reset_default_manager()
+    dispatch.set_global_policy(SelectionPolicy(strict=False))
+    monkeypatch.setattr(dispatch, "_OP_FAST_PATH_ENABLED", True)
+    mgr = dispatch.get_default_manager()
+    mgr._state.initialized = True
+    mgr._state.init_pid = os.getpid()
+    yield mgr
+    dispatch.reset_default_manager()
+    dispatch.reset_global_policy()
+
+
+@pytest.mark.parametrize("strict", [False, True])
+def test_cached_op_rechecks_each_input(manager, strict):
+    dispatch.set_global_policy(SelectionPolicy(strict=strict))
+    calls = []
+    manager.registry.register_many([
+        OpImpl("test", "primary", Kind.DEFAULT,
+               lambda x: calls.append("primary") or x * 2,
+               supports_inputs=lambda x: x % 2 == 0),
+        OpImpl("test", "vendor", Kind.VENDOR,
+               lambda x: calls.append("vendor") or x * 2, vendor="ascend"),
+    ])
+    op = dispatch.CachedOp("test")
+    assert [op(x) for x in [2, 3, 4]] == [4, 6, 8]
+    assert calls == ["primary", "vendor", "primary"]
+    assert manager.get_failed_impls() == {}
+
+
+@pytest.mark.parametrize("cached", [False, True])
+def test_partial_write_never_replayed_or_blacklisted(manager, cached):
+    calls = []
+
+    def partial_write(state):
+        state[0] += 1
+        raise RuntimeError("partial write")
+
+    manager.registry.register_many([
+        OpImpl("test", "primary", Kind.DEFAULT, partial_write,
+               runtime_fallback_safe=False),
+        OpImpl("test", "vendor", Kind.VENDOR,
+               lambda state: calls.append("vendor"), vendor="ascend"),
+    ])
+    op = dispatch.CachedOp("test") if cached else lambda x: manager.call("test", x)
+    for _ in range(2):
+        state = [0]
+        with pytest.raises(RuntimeError, match="partial write"):
+            op(state)
+        assert state == [1]
+    assert calls == []
+    assert manager.get_failed_impls() == {}
